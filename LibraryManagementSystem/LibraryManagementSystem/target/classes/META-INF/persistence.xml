<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                https://jakarta.ee/xml/ns/persistence
                https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="libraryPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <class>org.example.entity.Author</class>
        <class>org.example.entity.Book</class>
        <class>org.example.entity.Publisher</class>
        <class>org.example.entity.Category</class>
        <class>org.example.entity.Person</class>
        <class>org.example.entity.Employee</class>
        <class>org.example.entity.Customer</class>
        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.h2.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:librarydb;DB_CLOSE_DELAY=-1"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="sa"/>

            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <property name="hibernate.hbm2ddl.auto"
                      value="create"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>